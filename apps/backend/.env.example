PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="YOUR_MYSQL_PASSWORD"
# Legacy / default company tenant (existing SRSB production database).
DB_NAME=srsb_hrms
# Platform registry (companies, activation codes). Created automatically on boot.
MASTER_DB_NAME=srsb_platform
# Optional alias for MASTER_DB_NAME:
# PLATFORM_DB_NAME=srsb_platform
DEFAULT_COMPANY_CODE=SRSB
DEFAULT_COMPANY_NAME=SRSB Workforce Solutions
# Optional: enables HTTP platform admin routes (/api/platform/*).
# Leave empty to use CLI only (npm run activation:create / companies:*).
PLATFORM_ADMIN_KEY=
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Set NODE_ENV=production on live servers. DEMO_MODE=true enables fictional
# DEMO onboarding cases for local product demos; it is ignored in production.
NODE_ENV=development
DEMO_MODE=false

# SMTP is used for ADMIN / SUPER_ADMIN password recovery and joiner invitations.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@srsbworkforcesolutions.com
SMTP_PASSWORD="YOUR_MAILBOX_PASSWORD"
SMTP_FROM_NAME=SRSB Workforce Solutions
SMTP_FROM_EMAIL=info@srsbworkforcesolutions.com
OTP_EXPIRY_MINUTES=10

# Desktop update source. A token is required only when the GitHub repository
# is private. Use a fine-grained, read-only token for this one repository.
GITHUB_RELEASE_OWNER=digisrsb-byte
GITHUB_RELEASE_REPO=srsb-work-management
GITHUB_RELEASE_TOKEN=
GITHUB_RELEASE_CACHE_SECONDS=300
PUBLIC_API_URL=https://srsb-work-management-production.up.railway.app

# Account activation links emailed to new joiners
# Public URL of the frontend used in the link (defaults to the first CORS_ORIGIN)
APP_BASE_URL=http://localhost:5173
INVITE_EXPIRY_HOURS=48
# Development only: show the activation link to the admin when the email fails (ignored in production)
INVITE_LINK_FALLBACK=true
UPLOAD_MAX_MB=10

# Monthly auto payroll for the previous month (runs 1st-7th at 02:00 IST).
PAYROLL_AUTO_RUN=true

# Field and file encryption (AES-256-GCM) for bank and identity numbers and onboarding uploads.
# Not used by the app yet — see docs/SENSITIVE_DATA_ENCRYPTION.md before enabling.
# Generate each key separately with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use different keys in every environment. Keep production keys in a secret manager, never in git.
# FIELD_ENCRYPTION_KEYS={"k2026a":"<base64 32-byte key>"}
# FIELD_ENCRYPTION_ACTIVE_KEY_ID=k2026a
# BLIND_INDEX_KEY=<different base64 32-byte key>
