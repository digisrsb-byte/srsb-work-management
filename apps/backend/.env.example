PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="YOUR_MYSQL_PASSWORD"
# Legacy / default company tenant (existing SRSB production database).
DB_NAME=srsb_hrms
# Platform registry (companies, activation codes). Created automatically on boot.
MASTER_DB_NAME=srsb_platform
# Optional alias for MASTER_DB_NAME:
# PLATFORM_DB_NAME=srsb_platform
DEFAULT_COMPANY_CODE=SRSB
DEFAULT_COMPANY_NAME=SRSB Workforce Solutions
# Optional: enables HTTP platform admin routes (/api/platform/*).
# Leave empty to use CLI only (npm run activation:create / companies:*).
PLATFORM_ADMIN_KEY=
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# SMTP is used only for ADMIN and SUPER_ADMIN password recovery.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@srsbworkforcesolutions.com
SMTP_PASSWORD="YOUR_MAILBOX_PASSWORD"
SMTP_FROM_NAME=SRSB Workforce Solutions
SMTP_FROM_EMAIL=info@srsbworkforcesolutions.com
OTP_EXPIRY_MINUTES=10

# Desktop update source. A token is required only when the GitHub repository
# is private. Use a fine-grained, read-only token for this one repository.
GITHUB_RELEASE_OWNER=digisrsb-byte
GITHUB_RELEASE_REPO=srsb-work-management
GITHUB_RELEASE_TOKEN=
GITHUB_RELEASE_CACHE_SECONDS=300
PUBLIC_API_URL=https://srsb-work-management-production.up.railway.app
