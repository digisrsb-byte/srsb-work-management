{
  "name": "srsb-hrms-desktop",
  "version": "1.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "36.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.srsb.hrms",
    "productName": "SRSB Work Management",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png",
      "app-icon.png",
      "app-icon.ico"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "SRSB-Work-Management-Setup-${version}.${ext}",
      "icon": "app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "app-icon.ico",
      "uninstallerIcon": "app-icon.ico",
      "installerHeaderIcon": "app-icon.ico",
      "shortcutName": "SRSB Work Management"
    },
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "SRSB-Work-Management-Setup-${version}.${ext}"
  },
  "description": "SRSB Work Management desktop application",
  "author": "SRSB Workforce Solutions"
}
